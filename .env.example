# ==========================================
# ENVIRONNEMENT
# ==========================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ==========================================
# BASE DE DONNEES (MySQL en production / SQLite temporairement en dev)
# ==========================================
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=liifeisgood_db
DB_USER=liife_user
DB_PASSWORD=liife_password_secure
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==========================================
# REDIS (Queue + Cache)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# SECURITE JWT
# ==========================================
# MINIMUM 64 caracteres pour HS256. En production, utiliser RS256 avec cle privee.
JWT_ACCESS_SECRET=votre_cle_super_secrete_access_64chars_minimum_changez_moi_vite
JWT_REFRESH_SECRET=votre_cle_super_secrete_refresh_64chars_minimum_changez_moi_vite
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=liifeisgood-api
JWT_AUDIENCE=liifeisgood-client

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_ROUNDS=12

# ==========================================
# EMAIL (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
SMTP_FROM_NAME="Liife'is Good"
SMTP_FROM_EMAIL=noreply@liifeisgood.cm

# ==========================================
# SMS (Africa's Talking - recommande pour Cameroun)
# ==========================================
SMS_PROVIDER=africastalking
AFRICASTALKING_API_KEY=votre_cle_api
AFRICASTALKING_USERNAME=votre_username
AFRICASTALKING_SENDER=LIIFEISGOOD
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# ==========================================
# WHATSAPP BUSINESS API
# ==========================================
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=webhook_verify_aleatoire_32chars

# ==========================================
# AWS S3 (Stockage images/documents)
# ==========================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=liifeisgood-uploads
AWS_S3_ENDPOINT=

# ==========================================
# PAIEMENT - CAMEROUN
# ==========================================
PAYMENT_DEFAULT_CURRENCY=XAF
PAYMENT_MIN_AMOUNT=500

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_MODE=sandbox

# OPay
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MODE=sandbox

# Orange Money API Directe
ORANGE_MONEY_AUTHORIZATION_HEADER=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_PIN=

# MTN Mobile Money API Directe
MTN_MONEY_API_USER=
MTN_MONEY_API_KEY=
MTN_MONEY_SUBSCRIPTION_KEY=
MTN_MONEY_ENVIRONMENT=sandbox

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info
LOG_DIR=logs