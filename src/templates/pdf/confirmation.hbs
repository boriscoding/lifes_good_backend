<!DOCTYPE html>

<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Confirmation de réservation - {{reference}}</title>

  <style>
    @page {
      size: A4;
      margin: 20mm;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background: #f4f6f8;
      color: #1f2937;
      font-family: Arial, Helvetica, sans-serif;
    }

    .page {
      max-width: 760px;
      margin: 0 auto;
      padding: 25px;
    }

    .card {
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
    }

    /* HEADER */

    .header {
      background: linear-gradient(135deg, #15803d, #22a06b);
      padding: 35px 30px;
      text-align: center;
      color: #ffffff;
    }

    .brand {
      margin: 0;
      font-size: 25px;
      font-weight: bold;
      letter-spacing: .3px;
    }

    .brand-subtitle {
      margin: 5px 0 25px;
      color: #dcfce7;
      font-size: 12px;
    }

    .header-title {
      margin: 0;
      font-size: 25px;
      letter-spacing: .5px;
    }

    /* SUCCESS ICON */

    .success-container {
      text-align: center;
      padding: 35px 30px 10px;
    }

    .success-icon {
      width: 70px;
      height: 70px;
      line-height: 70px;
      margin: 0 auto;
      border-radius: 50%;
      background: #ecfdf5;
      color: #16a34a;
      font-size: 35px;
      font-weight: bold;
    }

    /* CONTENT */

    .content {
      padding: 15px 45px 40px;
    }

    .welcome {
      margin: 0 0 8px;
      text-align: center;
      font-size: 21px;
      color: #1f2937;
    }

    .description {
      margin: 0 auto 30px;
      max-width: 520px;
      text-align: center;
      font-size: 14px;
      line-height: 1.7;
      color: #6b7280;
    }

    /* REFERENCE */

    .reference-box {
      margin-bottom: 25px;
      padding: 22px;
      text-align: center;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      border-radius: 10px;
    }

    .reference-label {
      margin-bottom: 7px;
      color: #166534;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .reference {
      color: #15803d;
      font-size: 24px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    /* DETAILS */

    .details {
      width: 100%;
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      overflow: hidden;
    }

    .details-header {
      padding: 17px 20px;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
      font-size: 15px;
      font-weight: bold;
    }

    .detail-row {
      width: 100%;
      border-bottom: 1px solid #e5e7eb;
    }

    .detail-row:last-child {
      border-bottom: none;
    }

    .detail-cell {
      padding: 15px 20px;
      font-size: 14px;
    }

    .label {
      width: 45%;
      color: #6b7280;
    }

    .value {
      text-align: right;
      color: #1f2937;
      font-weight: bold;
    }

    /* ARRIVAL NOTICE */

    .notice {
      margin-top: 25px;
      padding: 16px 18px;
      background: #eff6ff;
      border-left: 4px solid #2c5aa0;
      border-radius: 6px;
      color: #475569;
      font-size: 13px;
      line-height: 1.6;
    }

    .notice strong {
      color: #1e40af;
    }

    /* FOOTER */

    .footer {
      padding: 28px 30px;
      background: #f8fafc;
      border-top: 1px solid #e5e7eb;
      text-align: center;
    }

    .footer-brand {
      margin: 0 0 7px;
      color: #374151;
      font-size: 14px;
      font-weight: bold;
    }

    .footer-text {
      margin: 0;
      color: #9ca3af;
      font-size: 11px;
      line-height: 1.5;
    }

    .copyright {
      margin-top: 8px;
    }

    /* PRINT */

    @media print {

      body {
        background: #ffffff;
      }

      .page {
        padding: 0;
        max-width: none;
      }

      .card {
        box-shadow: none;
      }

    }

  </style>

</head>

<body>

  <div class="page">

```
