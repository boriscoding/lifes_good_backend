                  {{amount}} FCFA
                </div>

              </td>
            </tr>

          </table>

          <!-- Détails transaction -->
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; overflow:hidden;">

            <tr>
              <td colspan="2" style="
                padding:18px 20px;
