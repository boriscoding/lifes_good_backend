          <!-- Montant -->
          <table width="100%" cellpadding="0" cellspacing="0" border="0"
            style="background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; margin-bottom:20px;">

            <tr>
              <td align="center" style="padding:22px 20px;">

                <div style="
                  font-size:12px;
                  text-transform:uppercase;
                  letter-spacing:1px;
