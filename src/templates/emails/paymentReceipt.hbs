                font-size:16px;
                font-weight:bold;
                color:#1f2937;
              ">
                Détails du paiement
              </td>
            </tr>

            <tr>
              <td style="padding:15px 20px 7px; font-size:14px; color:#6b7280;">
                Référence
              </td>

              <td align="right" style="padding:15px 20px 7px; font-size:14px; font-weight:bold; color:#1f2937;">
                {{reference}}
              </td>
            </tr>

            <tr>
              <td style="padding:7px 20px; font-size:14px; color:#6b7280;">
                Date
              </td>

              <td align="right" style="padding:7px 20px; font-size:14px; font-weight:bold; color:#1f2937;">
                {{date}}
              </td>
            </tr>

            <tr>
              <td style="padding:7px 20px 18px; font-size:14px; color:#6b7280;">
